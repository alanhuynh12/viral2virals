# Server Configuration
PORT=3000
NODE_ENV=development

# AWS S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=your_s3_bucket_name

# Google Gemini API Configuration (used for video analysis, gemini-2.5-flash)
GEMINI_API_KEY=your_google_api_key
GEMINI_MODEL=gemini-2.5-flash
# Set to "true" to skip the real (billed) Gemini video-understanding call and
# use a fixture analysis instead - useful for local development.
MOCK_ANALYSIS=false

# Google Veo Configuration (used for video generation)
# Veo is served through the Gemini API, so it reuses GEMINI_API_KEY by default.
# Set VEO_API_KEY only if you want to use a different key/project for video generation.
# VEO_API_KEY=your_google_api_key
# Model options: veo-3.0-generate-001, veo-3.0-fast-generate-001,
#                 veo-3.1-generate-preview, veo-3.1-fast-generate-preview
VEO_MODEL=veo-3.1-fast-generate-preview
VEO_ASPECT_RATIO=9:16
VEO_RESOLUTION=720p
# Set to "true" to synthesize placeholder clips with ffmpeg instead of calling
# the (billed) Veo API - useful for local development and testing the
# multi-clip stitching + batch-variant pipeline for free.
MOCK_VIDEO_GENERATION=false

# Laozhang.ai API Configuration (for GPT-5 text prompt generation only)
LAOZHANG_API_KEY=your_laozhang_api_key
LAOZHANG_API_BASE_URL=https://api.laozhang.ai/v1
OPENAI_GPT_MODEL=gpt-5

# Batch prompt/video variant generation
DEFAULT_VARIANT_COUNT=3
MAX_SCENES_PER_VARIANT=6

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Session Configuration
SESSION_TTL_HOURS=24
